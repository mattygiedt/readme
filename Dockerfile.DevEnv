# docker buildx build --no-cache -f Dockerfile.DevEnv -t devenv:20261110 .
# docker buildx build --no-cache -f Dockerfile.DevEnv --build-arg JOBS=$(nproc) -t devenv:20261110 .
# docker run --network=host -it --rm --entrypoint /bin/bash --mount type=bind,source="$(pwd)",target=/workspace devenv:20261110

FROM ubuntu:26.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

ARG JOBS=16
ARG BUILD_TYPE=Release
# C++ standard used for every library built from source in this image
ARG CXX_STANDARD=20
WORKDIR /install

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      git \
      gdb \
      wget \
      htop \
      curl \
      sudo \
      mold \
      flex \
      cmake \
      bison \
      clang \
      clang-tidy \
      clang-format \
      ninja-build \
      pkg-config \
      python3 \
      python3-pip \
      python3-venv \
      libgoogle-perftools-dev \
 && rm -rf /var/lib/apt/lists/*

# C++ libraries available from Ubuntu.
# Abseil, protobuf and gRPC are built from source below, so their apt
# packages must NOT be installed here (mixing Abseil versions breaks linking).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libgtest-dev \
      libgmock-dev \
      libbenchmark-dev \
      rapidjson-dev \
      libbsd-dev \
      uuid-dev \
      zlib1g-dev \
      libssl-dev \
      libjitterentropy3-dev \
      libc-ares-dev \
      xz-utils \
      python3-dev \
      libbz2-dev \
      liblzma-dev \
      libzstd-dev \
      libicu-dev \
      libfl-dev \
      libcurl4-openssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Boost, built from source with b2 (the official release archive, checksum-verified).
# libbz2/liblzma/libzstd are for Boost.Iostreams, libicu for Boost.Locale/Regex,
# python3-dev for Boost.Python. MPI-based libraries are skipped.
ARG BOOST_VERSION=1.92.0
ARG BOOST_SHA256=ea7b982002cc9dfbe59b0b217b206f470dc75f3de0bb2973d844118934d82411
RUN curl -fsSL -o /install/boost.tar.xz \
      https://github.com/boostorg/boost/releases/download/boost-${BOOST_VERSION}/boost-${BOOST_VERSION}-b2-nodocs.tar.xz \
 && echo "${BOOST_SHA256}  /install/boost.tar.xz" | sha256sum -c - \
 && mkdir /install/boost \
 && tar -xJf /install/boost.tar.xz -C /install/boost --strip-components=1 \
 && cd /install/boost \
 && ./bootstrap.sh --prefix=/usr/local \
 && ./b2 install -j${JOBS} -d0 \
      variant=$([[ "${BUILD_TYPE}" == "Debug" ]] && echo debug || echo release) \
      cxxstd=${CXX_STANDARD} \
      link=static,shared \
      threading=multi \
      cxxflags=-fPIC \
      --without-mpi \
      --without-graph_parallel \
 && cd / \
 && rm -rf /install/boost /install/boost.tar.xz \
 && ldconfig

# Abseil, protobuf and gRPC, built from source as one consistent set.
# gRPC 1.85.2 was released against protobuf v35.1 and Abseil 20260526.0.
# We are using a newer Abseil.
ARG ABSL_VERSION=20260817.0
ARG PROTOBUF_VERSION=v35.1
ARG GRPC_VERSION=v1.85.2

RUN git clone --depth 1 --branch ${ABSL_VERSION} https://github.com/abseil/abseil-cpp.git /install/abseil \
 && cmake -S /install/abseil -B /install/abseil/build \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DABSL_PROPAGATE_CXX_STD=ON \
      -DABSL_ENABLE_INSTALL=ON \
      -DABSL_BUILD_TESTING=OFF \
 && cmake --build /install/abseil/build -j${JOBS} \
 && cmake --install /install/abseil/build \
 && rm -rf /install/abseil

RUN git clone --depth 1 --branch ${PROTOBUF_VERSION} https://github.com/protocolbuffers/protobuf.git /install/protobuf \
 && cmake -S /install/protobuf -B /install/protobuf/build \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -Dprotobuf_BUILD_TESTS=OFF \
      -Dprotobuf_LOCAL_DEPENDENCIES_ONLY=ON \
 && cmake --build /install/protobuf/build -j${JOBS} \
 && cmake --install /install/protobuf/build \
 && rm -rf /install/protobuf

RUN git clone --depth 1 --branch ${GRPC_VERSION} https://github.com/grpc/grpc.git /install/grpc \
 && git -C /install/grpc submodule update --init --depth 1 third_party/re2 third_party/grpc-proto \
 && cmake -S /install/grpc -B /install/grpc/build \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DgRPC_INSTALL=ON \
      -DgRPC_BUILD_TESTS=OFF \
      -DgRPC_ABSL_PROVIDER=package \
      -DgRPC_PROTOBUF_PROVIDER=package \
      -DgRPC_ZLIB_PROVIDER=package \
      -DgRPC_CARES_PROVIDER=package \
      -DgRPC_SSL_PROVIDER=package \
      -DgRPC_RE2_PROVIDER=module \
      -DgRPC_BUILD_GRPC_CSHARP_PLUGIN=OFF \
      -DgRPC_BUILD_GRPC_NODE_PLUGIN=OFF \
      -DgRPC_BUILD_GRPC_OBJECTIVE_C_PLUGIN=OFF \
      -DgRPC_BUILD_GRPC_PHP_PLUGIN=OFF \
      -DgRPC_BUILD_GRPC_RUBY_PLUGIN=OFF \
 && cmake --build /install/grpc/build -j${JOBS} \
 && cmake --install /install/grpc/build \
 && rm -rf /install/grpc \
 && ldconfig

# Aeron C/C++ client and C media driver (not packaged by Ubuntu).
# The Archive API is off because building it needs Java and Gradle.
ARG AERON_VERSION=1.54.2
RUN git clone --depth 1 --branch ${AERON_VERSION} https://github.com/aeron-io/aeron.git /install/aeron \
 && cmake -S /install/aeron -B /install/aeron/build \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
      -DBUILD_AERON_DRIVER=ON \
      -DBUILD_AERON_ARCHIVE_API=OFF \
      -DAERON_TESTS=OFF \
      -DAERON_UNIT_TESTS=OFF \
      -DAERON_SYSTEM_TESTS=OFF \
      -DAERON_BUILD_SAMPLES=OFF \
      -DAERON_BUILD_DOCUMENTATION=OFF \
      -DAERON_INSTALL_TARGETS=ON \
 && cmake --build /install/aeron/build -j${JOBS} \
 && cmake --install /install/aeron/build \
 && rm -rf /install/aeron \
 && ldconfig

# FlatBuffers library and flatc compiler
ARG FLATBUFFERS_VERSION=v25.12.19-2026-02-06-03fffb2
RUN git clone --depth 1 --branch ${FLATBUFFERS_VERSION} https://github.com/google/flatbuffers.git /install/flatbuffers \
 && cmake -S /install/flatbuffers -B /install/flatbuffers/build \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DFLATBUFFERS_CPP_STD=${CXX_STANDARD} \
      -DFLATBUFFERS_BUILD_TESTS=OFF \
      -DFLATBUFFERS_BUILD_BENCHMARKS=OFF \
      -DFLATBUFFERS_INSTALL=ON \
 && cmake --build /install/flatbuffers/build -j${JOBS} \
 && cmake --install /install/flatbuffers/build \
 && rm -rf /install/flatbuffers

# spdlog (compiled library, uses its bundled fmt)
ARG SPDLOG_VERSION=v1.17.0
RUN git clone --depth 1 --branch ${SPDLOG_VERSION} https://github.com/gabime/spdlog.git /install/spdlog \
 && cmake -S /install/spdlog -B /install/spdlog/build \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
      -DSPDLOG_BUILD_PIC=ON \
      -DSPDLOG_BUILD_EXAMPLE=OFF \
      -DSPDLOG_BUILD_TESTS=OFF \
      -DSPDLOG_INSTALL=ON \
 && cmake --build /install/spdlog/build -j${JOBS} \
 && cmake --install /install/spdlog/build \
 && rm -rf /install/spdlog

# prometheus-cpp (static): pull exposes /metrics for Prometheus to scrape,
# push sends to a Pushgateway (needs libcurl4-openssl-dev, installed above).
# Civetweb and the other third-party pieces come from its own submodules.
ARG PROMETHEUS_CPP_VERSION=v1.3.0
RUN git clone --depth 1 --branch ${PROMETHEUS_CPP_VERSION} --recurse-submodules --shallow-submodules \
      https://github.com/jupp0r/prometheus-cpp.git /install/prometheus-cpp \
 && cmake -S /install/prometheus-cpp -B /install/prometheus-cpp/build \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DBUILD_SHARED_LIBS=OFF \
      -DENABLE_PULL=ON \
      -DENABLE_PUSH=ON \
      -DENABLE_COMPRESSION=ON \
      -DENABLE_TESTING=OFF \
      -DUSE_THIRDPARTY_LIBRARIES=ON \
 && cmake --build /install/prometheus-cpp/build -j${JOBS} \
 && cmake --install /install/prometheus-cpp/build \
 && rm -rf /install/prometheus-cpp

# eventpp (header-only, not packaged by Ubuntu)
ARG EVENTPP_VERSION=master
RUN git clone --depth 1 --branch ${EVENTPP_VERSION} https://github.com/wqking/eventpp.git /install/eventpp \
 && cmake -S /install/eventpp -B /install/eventpp/build \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
 && cmake --install /install/eventpp/build \
 && rm -rf /install/eventpp

# Install nodejs
RUN curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# BlazingMQ (Bloomberg message queue): broker, tools and C++ client library.
# Built on Bloomberg's BDE and NTF libraries, all installed under /opt/bb.
# Versions follow BlazingMQ's own docker/build_deps.sh for the chosen release.
ARG BDE_VERSION=4.39.0.0
ARG NTF_VERSION=2.6.13
ARG BMQ_VERSION=v0.95.28
ENV PATH=/opt/bb/bin:/opt/bde-tools/bin:${PATH}
ENV PKG_CONFIG_PATH=/opt/bb/lib64/pkgconfig

# BDE (bde-tools is kept in /opt/bde-tools: its CMake toolchains are needed
# to build anything against BDE/BlazingMQ)
RUN git clone --depth 1 --branch ${BDE_VERSION} https://github.com/bloomberg/bde-tools.git /opt/bde-tools \
 && git clone --depth 1 --branch ${BDE_VERSION} https://github.com/bloomberg/bde.git /install/bde \
 && cd /install/bde \
 && eval "$(bbs_build_env -u opt_64_cpp${CXX_STANDARD})" \
 && bbs_build configure \
 && bbs_build build -j${JOBS} \
 && bbs_build --install=/opt/bb --prefix=/ install \
 && cd / \
 && rm -rf /install/bde
 
# NTF (Bloomberg networking library used by the broker and client)
RUN git clone --depth 1 --branch ${NTF_VERSION} https://github.com/bloomberg/ntf-core.git /install/ntf \
 && cd /install/ntf \
 && ./configure \
      --prefix /opt/bb \
      --without-usage-examples \
      --without-applications \
      --without-warnings-as-errors \
      --with-zlib \
      --without-zstd \
      --without-lz4 \
      --ufid opt_64_cpp${CXX_STANDARD} \
 && make -j${JOBS} \
 && make install \
 && cd / \
 && rm -rf /install/ntf
 
# BlazingMQ itself. Sample broker config is copied to /opt/bb/etc/bmqbrkr.
RUN git clone --depth 1 --branch ${BMQ_VERSION} https://github.com/bloomberg/blazingmq.git /install/blazingmq \
 && cmake -S /install/blazingmq -B /install/blazingmq/build -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE=/opt/bde-tools/BdeBuildSystem/toolchains/linux/gcc-default.cmake \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DBDE_BUILD_TARGET_SAFE=ON \
      -DBDE_BUILD_TARGET_64=ON \
      -DBDE_BUILD_TARGET_CPP${CXX_STANDARD}=ON \
      -DCMAKE_PREFIX_PATH="/opt/bde-tools/BdeBuildSystem;/opt/bb" \
      -DCMAKE_INSTALL_LIBDIR=lib64 \
 && cmake --build /install/blazingmq/build --parallel ${JOBS} \
 && cmake --install /install/blazingmq/build --prefix /opt/bb \
 && mkdir -p /opt/bb/etc \
 && cp -r /install/blazingmq/src/applications/bmqbrkr/etc /opt/bb/etc/bmqbrkr \
 && rm -rf /install/blazingmq \
 && echo /opt/bb/lib64 > /etc/ld.so.conf.d/opt-bb.conf \
 && ldconfig \
 && for f in /opt/bb/bin/*.tsk; do ln -s "$f" "${f%.tsk}"; done

# Create a user that matches the host user (name, UID, GID)
ARG USERNAME=mgiedt
ARG USER_UID=1000
ARG USER_GID=1000
RUN (userdel -r ubuntu || true) \
 && groupadd --gid ${USER_GID} ${USERNAME} \
 && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USERNAME} \
 && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
 && chmod 0440 /etc/sudoers.d/${USERNAME}

WORKDIR /workspace
USER ${USERNAME}

# Update tools to use UTF-8
ENV LANG=C.UTF-8
